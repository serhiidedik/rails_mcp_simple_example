<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= @reference.settings.server_title %> reference</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="How to connect to this MCP server, what each tool accepts and returns, and how a call travels through it.">
    <style>
      :root {
        color-scheme: light dark;
        --paper: #f6f9fc; --ink: #12263a; --muted: #4c6075; --rule: #ccd8e4; --well: #e8eff6; --link: #0d5a9e;
        --blue: #123a63; --blue-ink: #eaf3fb; --blue-muted: #a8c4de; --blue-line: #3d6a99; --grid: rgb(255 255 255 / .055); --refuse: #ffb59f;
        --read: #0a6e64; --write: #8a5300; --delete: #a5241c;
        --prose: Charter, "Bitstream Charter", "Sitka Text", Cambria, Georgia, serif;
        --code: ui-monospace, "SF Mono", "Cascadia Mono", "Segoe UI Mono", Menlo, Consolas, monospace;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #0c1a2a; --ink: #e4edf6; --muted: #a2b6ca; --rule: #27405a; --well: #14273c; --link: #86c5f7;
          --blue: #14406d; --read: #5fd6c6; --write: #f2bf70; --delete: #ff9d90;
        }
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body { margin: 0; background: var(--paper); color: var(--ink); font: 1.0625rem/1.6 var(--prose); }
      a { color: var(--link); text-underline-offset: .15em; }
      a:focus-visible, summary:focus-visible, pre:focus-visible, .table:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
      code, pre { font-family: var(--code); }
      code { font-size: .86em; background: var(--well); padding: .08em .3em; overflow-wrap: anywhere; }
      pre { margin: .5rem 0 1rem; padding: .85rem 1rem; overflow-x: auto; background: var(--well); font-size: .82rem; line-height: 1.5; }
      pre code { background: none; padding: 0; font-size: inherit; overflow-wrap: normal; }
      p { margin: 0 0 1rem; max-width: 40rem; }

      .masthead {
        background-color: var(--blue); color: var(--blue-ink); padding: 2.75rem 0 2.25rem;
        background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
        background-size: 1.5rem 1.5rem;
      }
      .masthead a { color: var(--blue-ink); }
      .masthead a:focus-visible { outline-color: var(--blue-ink); }
      .masthead code { background: none; padding: 0; color: inherit; }
      .wide { max-width: 66rem; margin-inline: auto; padding-inline: 1.5rem; }
      .masthead .server { margin-bottom: .6rem; color: var(--blue-muted); }
      h1 { margin: 0 0 1.1rem; font: 600 clamp(1.45rem, 4.9vw, 3.1rem)/1.12 var(--code); letter-spacing: -.02em; overflow-wrap: anywhere; }
      .lede { font-size: 1.2rem; line-height: 1.5; margin-bottom: 1.75rem; max-width: 38rem; }
      .facts { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: .3rem 1.25rem; margin: 0; font-size: .96rem; }
      .facts dt { color: var(--blue-muted); }
      .facts dd { margin: 0; }

      .page { display: grid; grid-template-columns: 12.5rem minmax(0, 1fr); gap: 3.5rem; padding-block: 2.5rem 4rem; }
      nav { position: sticky; top: 1.5rem; align-self: start; max-height: calc(100vh - 3rem); overflow-y: auto; font-size: .96rem; }
      nav ul { list-style: none; margin: 0; padding: 0; }
      nav li { margin-block: .3rem; }
      nav ul ul { margin-block: .3rem .6rem; padding-inline-start: .85rem; border-inline-start: 2px solid var(--rule); font-family: var(--code); font-size: .8rem; }
      main { min-width: 0; }

      section + section { margin-top: 3.25rem; }
      h2 { margin: 0 0 .75rem; font-size: 1.75rem; line-height: 1.2; font-weight: 600; letter-spacing: -.01em; }
      h3 { margin: 0 0 .25rem; font-size: 1.3rem; line-height: 1.3; font-weight: 600; }
      h3 code { background: none; padding: 0; font-size: 1em; }
      h4 { margin: 1.25rem 0 .35rem; font-size: 1rem; font-weight: 600; }

      .sequence { margin: 1.25rem 0 1.5rem; padding: 0 1rem 1.25rem; background: var(--blue); color: var(--blue-ink); font-size: .92rem; line-height: 1.4; }
      .sequence code { background: none; padding: 0; color: inherit; }
      .lanes { display: grid; position: sticky; top: 0; z-index: 1; grid-template-columns: repeat(var(--lanes), minmax(0, 1fr)); padding-block: .85rem .55rem; background: var(--blue); font: 600 .74rem/1.2 var(--code); }
      .lanes span { display: flex; justify-content: center; white-space: nowrap; }
      .sequence ol { list-style: none; margin: 0; padding: 0; counter-reset: step; }
      .step {
        display: grid; grid-template-columns: repeat(var(--lanes), minmax(0, 1fr)); padding-block-start: .55rem; counter-increment: step;
        background-image: linear-gradient(90deg, transparent calc(50% - .5px), var(--blue-line) calc(50% - .5px), var(--blue-line) calc(50% + .5px), transparent calc(50% + .5px));
        background-size: calc(100% / var(--lanes)) 100%;
      }
      .step p { grid-column: 1 / -1; justify-self: start; width: fit-content; max-width: calc(100% - var(--before)); margin: 0 0 .2rem var(--before); padding-inline: .3rem; background: var(--blue); }
      .step.from-right p { justify-self: end; max-width: calc(100% - var(--after)); margin: 0 var(--after) .2rem 0; text-align: right; }
      .step p::before { content: counter(step) ". "; color: var(--blue-muted); font: .78rem var(--code); }
      .refusal { display: block; color: var(--refuse); font-size: .86rem; }
      .arrow { position: relative; grid-column: var(--column); height: .5rem; margin-inline: calc(50% / var(--span)); border-bottom: 1.5px solid var(--blue-ink); }
      .arrow::after { content: ""; position: absolute; right: -1px; bottom: -5px; border-left: 8px solid var(--blue-ink); border-block: 4.5px solid transparent; }
      .leftward .arrow::after { right: auto; left: -1px; border-left: 0; border-right: 8px solid var(--blue-ink); }
      .reply .arrow { border-bottom: 1.5px dashed var(--blue-muted); }
      .reply .arrow::after { border-right-color: var(--blue-muted); }
      .check .arrow { justify-self: center; width: .65rem; height: .65rem; margin: 0; border: 1.5px solid var(--refuse); border-radius: 50%; background: var(--blue); }
      .check .arrow::after { content: none; }
      .key { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: .15rem 1rem; margin: 0 0 1.5rem; font-size: .92rem; }
      .key dt { font-weight: 600; }
      .key dd { margin: 0; }

      .table { overflow-x: auto; margin: .5rem 0 1rem; }
      table { width: 100%; border-collapse: collapse; font-size: .93rem; line-height: 1.45; }
      th, td { padding: .45rem .9rem .45rem 0; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
      th { font-weight: 600; white-space: nowrap; }
      td code { white-space: nowrap; }
      td.wrap code { white-space: normal; }

      .scope { font: 600 .82rem var(--code); border: 1.5px solid currentColor; padding: .05em .4em; white-space: nowrap; }
      .scope-read { color: var(--read); }
      .scope-write { color: var(--write); }
      .scope-delete { color: var(--delete); }
      .tool { margin-top: 2.5rem; padding-top: 1.75rem; border-top: 1px solid var(--rule); }
      .tool-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .75rem; margin: .35rem 0 .75rem; color: var(--muted); font-size: .96rem; }
      .example { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: 0 1rem; }
      .example h4 { margin-top: .75rem; }
      summary { cursor: pointer; font-weight: 600; font-size: 1rem; margin-top: 1rem; }
      details[open] summary { margin-bottom: .35rem; }
      .note { color: var(--muted); font-size: .96rem; }
      footer { border-top: 1px solid var(--rule); padding-block: 1.25rem 2rem; color: var(--muted); font-size: .92rem; }

      @media (max-width: 60rem) {
        .page { display: block; padding-block-start: 1.75rem; }
        nav { position: static; max-height: none; margin-bottom: 2.5rem; }
        nav ul ul { display: flex; flex-wrap: wrap; gap: .1rem 1rem; }
      }
      @media (max-width: 40rem) {
        .wide { padding-inline: 1rem; }
        .masthead { padding-block: 1.75rem 1.5rem; }
        .lede { font-size: 1.1rem; }
        .facts { grid-template-columns: minmax(0, 1fr); gap: 0; }
        .facts dd { margin-bottom: .55rem; }
        .sequence { margin-inline: -1rem; padding-inline: .75rem; }
        .lanes { font: 600 .66rem/1.2 var(--prose); }
        .step p, .step.from-right p { justify-self: start; max-width: 100%; margin: 0 0 .2rem; text-align: left; }
        .key { grid-template-columns: minmax(0, 1fr); }
        .key dd { margin-bottom: .4rem; }
      }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
