# Every variable this app reads, besides the database and Rails' own. Keep it in step with
# config/deploy.yml and docker-compose.yml. Nothing here is a secret.

# Public URL of this app, no trailing slash: the MCP resource and the OAuth issuer.
# Required in production, where it must be https. Defaults to http://localhost:3000 in development.
MCP_PUBLIC_URL=http://localhost:3000

# Browser origins accepted on /mcp besides same-origin, comma-separated.
# Clients that are not browsers send no Origin and need nothing here.
MCP_ALLOWED_ORIGINS=

# Requests per IP per 5 minutes, and login attempts per IP per minute.
RATE_LIMIT_REQ_IP=600
RATE_LIMIT_LOGIN_IP=10

# Development only: the demo user db/seeds.rb creates. A random password is printed if unset.
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=
